PORT=8000
MONGODB_URI=your_mongodb_connection_string
CORS_ORIGIN=http://localhost:5173,https://salon-booking-system-gaqg.onrender.com
FRONTEND_URL=https://salon-booking-system-gaqg.onrender.com
ADMIN_URL=http://localhost:5174

ACCESS_TOKEN_SECRET=your_access_token_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRY=10d

CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_CLOUD_API_KEY=your_cloudinary_api_key
CLOUDINARY_CLOUD_API_SECRET=your_cloudinary_api_secret
BREVO_API_KEY=xkeysib-your_api_key
SENDER_NAME=SalonNow
SENDER_EMAIL=your_email@gmail.com
# EMAIL_REPLY_TO=support@yourdomain.com

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── Razorpay Circuit Breaker & Timeout Configuration (Milestone 2) ───────────

# Hard deadline for every Razorpay SDK call (orders.create, payments.fetch, payments.refund).
# If the call doesn't respond within this window it is rejected with RazorpayTimeoutError.
# Increase only if Razorpay SLA consistently exceeds 8 s (rare). Default: 8000 ms.
RAZORPAY_TIMEOUT_MS=8000

# Time the circuit breaker stays OPEN before allowing a single probe (half-open) request.
# Lower values recover faster but risk amplifying load on a degraded gateway. Default: 30000 ms.
BREAKER_RESET_TIMEOUT_MS=30000

# Percentage of calls that must fail within the rolling window before opening the breaker.
# 50 = open when ≥ 50% of recent calls fail. Default: 50.
BREAKER_ERROR_THRESHOLD=50

# Minimum number of calls in the rolling window before the breaker will evaluate failure %.
# Prevents spurious opens during low-traffic periods. Default: 5.
BREAKER_VOLUME_THRESHOLD=5

# ─── Phase 3: Distributed Systems Configuration ───────────────────────────────

# Process role — controls what this Node.js instance runs.
#   api    — HTTP server + Socket.io only. No background workers.
#   worker — BullMQ workers + Outbox relay only. No HTTP server.
#   all    — Everything (default — backward-compatible for local dev).
PROCESS_TYPE=all

# MongoDB connection pool limits.
# Formula: Total = (API nodes x API_POOL) + (Worker nodes x WORKER_POOL)
# Target: up to 500 connections for MongoDB Atlas M10.
# API default: 15 | Worker default: 10 (auto-selected by PROCESS_TYPE)
MONGO_MAX_POOL_SIZE=15
MONGO_MIN_POOL_SIZE=2

# Redis topology mode.
#   standalone — Single Redis node (local dev, simple deployments)
#   sentinel   — Redis Sentinel (HA with failover, AWS ElastiCache Multi-AZ)
#   cluster    — Redis Cluster (sharded, AWS ElastiCache Cluster Mode)
REDIS_MODE=standalone

# Standalone Redis (used when REDIS_MODE=standalone or for BullMQ in all modes)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# Redis Sentinel (used when REDIS_MODE=sentinel)
# REDIS_SENTINEL_HOSTS=sentinel1.host:26379,sentinel2.host:26379
# REDIS_SENTINEL_MASTER_NAME=mymaster
# REDIS_SENTINEL_PASSWORD=

# Redis Cluster (used when REDIS_MODE=cluster)
# REDIS_CLUSTER_NODES=node1.host:6379,node2.host:6379,node3.host:6379

# MongoDB ChangeStream hold watcher (fallback for BullMQ hold expiry).
# Set to false on additional worker replicas to avoid multiple watchers.
ENABLE_HOLD_WATCHER=true
